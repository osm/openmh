#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
build="$root/build/checks/memory"

cmake -S "$root" -B "$build" \
    -DCMAKE_C_COMPILER=clang -DCMAKE_BUILD_TYPE=Debug \
    -DMH_BUILD_CLIENT=OFF -DBUILD_TESTING=ON \
    -DMH_ENABLE_SANITIZERS=ON -DMH_BUILD_FUZZERS=ON "$@"
cmake --build "$build" --parallel "${CMAKE_BUILD_PARALLEL_LEVEL:-4}"
ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=1}" \
    ctest --test-dir "$build" --output-on-failure \
        --parallel "${CMAKE_BUILD_PARALLEL_LEVEL:-4}"
